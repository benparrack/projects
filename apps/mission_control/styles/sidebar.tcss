/* "sidebar" layout - a narrow left column for the frequently-glanced-at
   stuff (Clock, Now Playing, Up Next), wider right area for the rest. */

#body {
    height: 1fr;
}

#sidebar {
    width: 38;
    padding: 1;
}

#sidebar > * {
    height: auto;
    margin-bottom: 1;
}

#nowplaying {
    height: 15;
}

#upnext {
    height: 12;
}

#main {
    width: 1fr;
    padding: 1;
}

#top_area {
    height: 24;
    margin-bottom: 1;
}

#top_left {
    width: 2fr;
}

#sys_weather_row {
    height: 11;
    margin-bottom: 1;
}

#sys_weather_row #system {
    width: 1fr;
}

#sys_weather_row #weather {
    width: 1fr;
    height: 11;
    margin-left: 1;
}

#top_area #calendar {
    width: 1fr;
    height: 1fr;
    margin-left: 1;
}

#notes {
    height: 12;
}

#git {
    height: 12;
}
