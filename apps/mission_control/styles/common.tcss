/* Shared across every layout: widget/panel look, not structural
   placement (that lives in each layout's own stylesheet). */

Screen {
    background: $background;
}

TopBar {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $primary;
    text-style: bold;
}

Panel, LivePanel, NotesPanel {
    border: round $primary;
    padding: 1 2;
    background: $panel;
    overflow: hidden;
}

/* Utility: hide a widget without unmounting it (e.g. Notes' add-item
   Input when the user isn't actively adding). */
.hidden {
    display: none;
}

#system {
    border: round $primary;
}

#weather {
    border: round $warning;
}

#calendar {
    border: round $accent;
}

#nowplaying {
    border: round $panel-teal;
}

#clock {
    border: round $secondary;
}

#upnext {
    border: round $panel-pink;
}

#git {
    border: round $success;
}

#notes {
    border: round $error;
}

SystemPanel Label {
    height: 1;
}

SystemPanel Sparkline {
    height: 1;
    margin-bottom: 1;
}
