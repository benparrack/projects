# --- YouTube (Shorts upload) ---
# Download an OAuth client secrets JSON (Desktop app type) from Google Cloud
# Console -> APIs & Services -> Credentials, enable the YouTube Data API v3.
YOUTUBE_CLIENT_SECRETS_FILE=youtube_client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# --- Instagram (Reels publish) ---
# Only usable after Meta's App Review approves instagram_business_basic +
# instagram_business_content_publish for your app — see README.md.
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Twitch (only needed if you later call the official Helix API directly;
# the chat-replay fetch and yt-dlp downloads don't need this) ---
TWITCH_CLIENT_ID=

# DO NOT UNCOMMENT unless you deliberately intend to enable live posting to
# real accounts. Requires --post on the command line as well - both are
# required together. Without this, `main.py post` always dry-runs.
# ALLOW_AUTO_POST=true

# Optional overrides (defaults in config.py are fine for a first run):
# WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
