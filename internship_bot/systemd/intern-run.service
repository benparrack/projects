# Fetches new postings and works through up to 5 (dry runs unless auto-submit is on). Install: see README.
[Unit]
Description=Internship bot: fetch + apply pass
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/internship_bot
Environment=PATH=/home/ben/AppDev/Tools/nvm/versions/node/v22.23.2/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ben/AppDev/Tools/nvm/versions/node/v22.23.2/bin/node --no-warnings src/run.js --apply 5
TimeoutStartSec=50min
Nice=10
